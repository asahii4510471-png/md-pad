{
  "name": "md-pad — Markdownリーダー / エディタ",
  "short_name": "md-pad",
  "lang": "ja",
  "id": "/md-pad/",
  "start_url": "/md-pad/",
  "scope": "/md-pad/",
  "display": "standalone",
  "background_color": "#fcfcfa",
  "theme_color": "#fcfcfa",
  "icons": [
    {
      "src": "/md-pad/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/md-pad/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/md-pad/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "/md-pad/",
      "accept": {
        "text/markdown": [
          ".md"
        ]
      },
      "launch_type": "single-client"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
